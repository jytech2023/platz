  "features": {
    "title": "为什么选择 Platz 病床",
    "subtitle": "源自日本的专利工程，降低误吸风险、缓解压疮、防止跌倒——服务于医院、护理机构与居家照护。",
    "items": [
      {
        "title": "高位背支撑功能",
        "description": "专利申请中的机构将头/中背与下背分离，可独立调整每段角度。相比传统病床，骶骨压力最高可降低 39%。"
      },
      {
        "title": "降低误吸风险",
        "description": "调整抬背时的颈部角度并降低腹部压力，有助于吞咽——支持吞咽障碍康复，降低吸入性肺炎风险。"
      },
      {
        "title": "超低床面（15 cm）",
        "description": "Rafio 与 Miolet III Basic Bed 系列床面距地仅 15 cm——非常适合认知障碍用户或有坠床风险的人群。"
      },
      {
        "title": "丹麦 LINAK 高功能电机",
        "description": "高功能、静音的丹麦 LINAK 电机，具备 IPX4 防水（高位背机型 IPX6）。提供 2 电机、3 电机及高位背电动配置。"
      },
      {
        "title": "通用设计控制面板",
        "description": "彩色凹刻按键，弱握力或视觉受限用户也能凭触感操作。控制锁定功能防止误操作。"
      },
      {
        "title": "JIS T9254 认证",
        "description": "所有 Platz 病床均通过日本工业标准 T9254 认证。专利第 5089786 号（控制面板形状），高位背支撑与倾角控制专利申请中。"
      }
    ]
  },
  "scenarios": {
    "title": "Platz 病床的应用场景",
    "subtitle": "广泛应用于日本及海外的医院、护理机构和居家环境。每个系列都为特定的护理场景而设计。",
    "items": [
      {
        "name": "急性期医院",
