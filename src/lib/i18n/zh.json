  "cases": {
    "title": "临床证据",
    "subtitle": "在日本医院测试，使用加拿大 VERG 公司的 FSA 压力测量设备，配合 Thank U Point 与 Amical Support 床垫。",
    "items": [
      {
        "title": "30° 抬背时骶骨压力降低 34%",
        "description": "Rafio 系列在传统 30° 抬背时骶骨压力为 53 mmHg，启用高位背支撑功能后降至 35 mmHg——降幅达 34%。"
      },
      {
        "title": "70° 抬背时骶骨压力降低 39%",
        "description": "在更陡的 70° 抬背角度下，传统床骶骨压力达 123 mmHg。使用高位背支撑后降至 75 mmHg——降幅 39%。"
      },
      {
        "title": "P300 医院床：60° 时降低 31%",
        "description": "P300 系列医院床在抬背 60° 时骶骨压力降低 31%，从 97 mmHg 降至 67 mmHg。"
      },
      {
        "title": "Ardel 护理机构床：70° 时降低 28%",
        "description": "Ardel 体位床在 70° 抬背时最高压力从 118 mmHg 降至 85 mmHg——比传统床改善 28%。"
      },
      {
        "title": "改善呼吸与体位",
        "description": "扩展横膈膜并降低背部压力有助于呼吸。弯曲上躯干也减轻对循环器官的压力，支持脊柱后凸或孕期用户。"
      }
    ]
  },
