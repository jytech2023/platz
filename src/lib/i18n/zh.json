        "algorithms": ["高位背支撑", "15 cm 床面高度", "压疮预防"]
      },
      {
        "name": "护理机构",
        "description": "Ardel 护理机构床将高位背支撑功能与电动倾角调节相结合，应对各种身体条件的高级护理环境。",
        "algorithms": ["电动高位背", "膝部位置调节", "轮椅转移"]
      },
      {
        "name": "居家照护",
